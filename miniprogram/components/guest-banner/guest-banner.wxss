.guest-banner {
  display: flex;
  align-items: center;
  gap: 24rpx;
  margin-bottom: 24rpx;
  padding: 28rpx;
  border: 2rpx solid #CFE1F4;
  border-radius: 20rpx;
  box-sizing: border-box;
  background: linear-gradient(135deg, #F7FBFF 0%, #EAF3FC 100%);
}

.guest-copy { flex: 1; min-width: 0; }
.guest-label { display: flex; align-items: center; color: #326FAF; font-size: 24rpx; font-weight: 600; }
.guest-dot { width: 12rpx; height: 12rpx; margin-right: 10rpx; border-radius: 50%; background: #4A90D9; }
.guest-title { margin-top: 8rpx; color: #2C3E50; font-size: 30rpx; font-weight: 700; line-height: 1.4; }
.guest-description { margin-top: 8rpx; color: #66757F; font-size: 24rpx; line-height: 1.55; }
.guest-action { flex: 0 0 auto; min-height: 88rpx; padding: 0 24rpx; border-radius: 16rpx; color: #FFFFFF; background: #4A90D9; font-size: 26rpx; font-weight: 600; line-height: 1.3; }
.guest-action-pressed { opacity: 0.82; }

@media (max-width: 340px) {
  .guest-banner { align-items: stretch; flex-direction: column; }
  .guest-action { width: 100%; }
}
