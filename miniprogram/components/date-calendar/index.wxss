.calendar-overlay { position: fixed; top: 0; right: 0; bottom: 0; left: 0; z-index: 60; background: rgba(20, 39, 54, .4); display: flex; align-items: flex-end; }
.calendar-sheet { width: 100%; box-sizing: border-box; border-radius: 24rpx 24rpx 0 0; background: #fff; padding: 12px 12px 16px; padding-bottom: calc(16px + constant(safe-area-inset-bottom)); padding-bottom: calc(16px + env(safe-area-inset-bottom)); color: #21333f; }
button { margin: 0; padding: 0; border-radius: 12px; background: transparent; color: inherit; line-height: 1.2; }
button::after { border: none; }
.calendar-header, .calendar-month { display: flex; align-items: center; justify-content: space-between; font-size: 18px; font-weight: 600; }
.calendar-close, .calendar-arrow { width: 44px; height: 44px; display: flex; align-items: center; justify-content: center; font-size: 28px; color: #397bc5; }
.calendar-week, .calendar-days { display: flex; flex-wrap: wrap; }
.calendar-week text { width: 14.285714%; line-height: 36px; text-align: center; font-size: 14px; color: #748694; }
.calendar-day { width: 14.285714%; height: 48px; display: flex; flex-direction: column; align-items: center; justify-content: center; font-size: 16px; }
.calendar-marker { font-size: 10px; line-height: 12px; min-height: 12px; }
.outside { color: #8797a3; }
.today { color: #245f9f; background: #edf5ff; }
.selected { color: white; background: #397bc5; font-weight: 600; }
.calendar-today { min-height: 44px; display: flex; align-items: center; justify-content: center; margin-top: 12px; color: #245f9f; background: #eaf3ff; font-size: 16px; }
.calendar-day:active, .calendar-arrow:active, .calendar-close:active { opacity: .65; }
