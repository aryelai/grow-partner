.view-tabs { display: flex; margin-bottom: 20rpx; padding: 8rpx; border-radius: 16rpx; background: #E8ECF1; }
.view-tab { flex: 1; padding: 14rpx; border-radius: 12rpx; text-align: center; color: var(--text-light); }
.view-tab.active { color: var(--primary); background: #fff; font-weight: 600; }
.date-nav { display: flex; align-items: center; justify-content: space-between; margin-bottom: 24rpx; }
.date-nav button { width: 80rpx; color: var(--primary); background: transparent; font-size: 48rpx; }
.date-label { text-align: center; font-weight: 600; }
.completion { margin-top: 6rpx; text-align: center; color: var(--success); font-size: 22rpx; }
.plan-header { display: flex; justify-content: space-between; margin-bottom: 16rpx; font-size: 32rpx; font-weight: 600; }
.plan-header .muted { font-size: 22rpx; font-weight: 400; }
.plan-item { display: flex; align-items: center; min-height: 76rpx; border-top: 2rpx solid var(--border); }
.priority { width: 16rpx; height: 16rpx; margin-right: 16rpx; border-radius: 50%; }
.priority.high { background: var(--danger); }.priority.medium { background: var(--warning); }.priority.low { background: var(--primary); }
.item-text { flex: 1; }.item-text.done { color: var(--gray); text-decoration: line-through; }
.notes { margin-top: 16rpx; color: var(--text-light); font-size: 23rpx; }
