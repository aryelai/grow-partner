<view class="login-page">
  <view class="brand">
    <view class="brand-mark">长</view>
    <view class="brand-title">成长搭档</view>
    <view class="brand-subtitle">把作业、通知与成长计划放在一起</view>
  </view>

  <view class="card profile-card" wx:if="{{!loading && !loadFailed && !registered && registrationMode !== 'closed'}}">
    <view class="section-title">使用我的家庭</view>
    <view class="form-intro">只有在保存和同步家庭数据前，才需要登记家庭称呼。不会读取你的微信头像、微信昵称或手机号。</view>
    <view class="field">
      <text class="field-label">家庭称呼</text>
      <input class="input nickname-input" maxlength="30" placeholder="例如：妈妈、爸爸" value="{{nickname}}" bindinput="onNicknameInput" />
    </view>
    <view class="field" wx:if="{{registrationMode === 'family_invite'}}">
      <text class="field-label">家庭邀请码</text>
      <input class="input invite-input" maxlength="9" placeholder="例如：ABCD-EFGH" value="{{inviteCode}}" bindinput="onInviteCodeInput" />
      <view class="privacy-note">注册成功后仍需在加入家庭页再次输入邀请码并等待创建者审批。</view>
    </view>
    <button class="primary-button register-button" bindtap="register" loading="{{submitting}}" disabled="{{submitting}}">确认登记并继续</button>
    <button class="ghost-button continue-button" bindtap="continueExperience">暂不登记，继续体验</button>
    <view class="privacy-note">点击“确认登记并继续”代表你主动使用家庭协作功能；无需提供手机号。</view>
  </view>

  <view class="card profile-card" wx:if="{{!loading && !loadFailed && !registered && registrationMode === 'closed'}}">
    <view class="section-title">家庭内测暂未开放注册</view>
    <view class="form-intro">你仍可浏览作业、通知、习惯和计划的本地演示内容。需要保存数据时，再联系家庭创建者确认内测资格。</view>
    <button class="ghost-button continue-button" bindtap="continueExperience">继续体验</button>
  </view>

  <view class="card profile-card" wx:if="{{!loading && loadFailed}}">
    <view class="section-title">登录状态加载失败</view>
    <view class="privacy-note">请检查网络后重试，系统不会把临时故障当作注册关闭。</view>
    <button class="ghost-button choice-button" bindtap="retryProfile">重新加载</button>
    <button class="ghost-button continue-button" bindtap="continueExperience">先继续体验</button>
  </view>

  <view class="card family-choice" wx:if="{{!loading && !loadFailed && registered && !hasFamily}}">
    <view class="section-title">选择使用方式</view>
    <button wx:if="{{canCreateFamily}}" class="primary-button choice-button" bindtap="goCreateFamily">创建孩子档案与家庭</button>
    <button class="ghost-button choice-button" bindtap="goJoinFamily">加入已有家庭</button>
    <button class="ghost-button continue-button" bindtap="continueExperience">暂不选择，继续体验</button>
    <view class="pending-tip" wx:if="{{pending}}">加入申请正在等待创建者处理</view>
  </view>
</view>
