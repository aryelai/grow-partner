.switch-row { display: flex; align-items: center; justify-content: space-between; min-height: 88rpx; box-sizing: border-box; }
.deadline-row { display: flex; gap: 16rpx; margin: 24rpx 0; }.deadline-row picker { flex: 1; min-width: 0; }
.check { display: inline-flex; align-items: center; min-height: 72rpx; margin-right: 30rpx; }
.target-label { margin: 28rpx 0 14rpx; color: var(--text-light); font-size: 26rpx; }
.target-check { display: inline-flex; min-width: 30%; margin-bottom: 8rpx; }
.image-grid { display: flex; flex-wrap: wrap; margin-top: 20rpx; }
.image-wrap { position: relative; width: calc((100% - 24rpx) / 3); height: 190rpx; margin: 0 12rpx 12rpx 0; }.image-wrap:nth-child(3n) { margin-right: 0; }
.image-wrap image { width: 100%; height: 100%; border-radius: 12rpx; }
.image-wrap text { position: absolute; top: 4rpx; right: 8rpx; width: 40rpx; height: 40rpx; border-radius: 50%; color: #fff; background: rgba(0,0,0,.55); text-align: center; }
.save { margin-top: 24rpx; }
.remove-button { margin-top: 18rpx; margin-bottom: 60rpx; }
