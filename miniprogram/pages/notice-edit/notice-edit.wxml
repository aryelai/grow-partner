<view class="page">
  <view class="ai-draft-note" wx:if="{{aiDraftRequestId}}">
    <view class="ai-draft-title">通知识别草稿</view>
    <view class="ai-draft-detail">请核对标题、来源、分类和正文后再保存。系统不会自动开启提醒。</view>
    <view class="ai-time-row" wx:if="{{aiSuggestedRemindTime}}"><view><view class="ai-time-label">识别到时间建议</view><view class="ai-time-value">{{aiSuggestedRemindTimeText}}</view></view><button class="ghost-button ai-time-button" bindtap="useAiSuggestion" disabled="{{submitting || initializing || initializationFailed}}">采用时间</button></view>
  </view>
  <view class="card">
    <view class="field"><text class="field-label">标题 *</text><input class="input" maxlength="80" value="{{form.title}}" data-field="title" bindinput="onInput" placeholder="请输入通知标题" disabled="{{submitting || initializing || initializationFailed}}" /></view>
    <view class="field"><text class="field-label">来源</text><input class="input" maxlength="60" value="{{form.source}}" data-field="source" bindinput="onInput" placeholder="例如：班主任-王老师" disabled="{{submitting || initializing || initializationFailed}}" /></view>
    <view class="field"><text class="field-label">分类</text><view class="tag-group"><text wx:for="{{categories}}" wx:key="value" class="tag {{form.category === item.value ? 'active' : ''}}" data-value="{{item.value}}" bindtap="selectCategory">{{item.label}}</text></view></view>
    <view class="field"><text class="field-label">内容</text><textarea class="textarea" maxlength="3000" value="{{form.content}}" data-field="content" bindinput="onInput" disabled="{{submitting || initializing || initializationFailed}}" /></view>
    <view class="field requirements-editor">
      <view class="requirements-editor-head"><view><view class="field-label">内部要求清单</view><view class="muted requirement-help">把需要落实的事项逐条列出，便于完成后分别勾选。</view></view><button class="ghost-button add-requirement" disabled="{{submitting || initializing || initializationFailed || form.requirements.length >= 20}}" bindtap="addRequirement">＋ 添加</button></view>
      <view class="requirement-edit-row" wx:for="{{form.requirements}}" wx:key="id">
        <text class="requirement-index">{{index + 1}}</text>
        <input class="input requirement-input" maxlength="200" value="{{item.text}}" data-index="{{index}}" bindinput="onRequirementInput" placeholder="例如：周五前提交回执" disabled="{{submitting || initializing || initializationFailed}}" />
        <button class="requirement-remove" data-index="{{index}}" bindtap="removeRequirement" disabled="{{submitting || initializing || initializationFailed}}" aria-label="删除第 {{index + 1}} 项要求">×</button>
      </view>
    </view>
    <view class="muted">家庭内测期间暂不支持新增附件，已有图片仍可查看。</view>
    <view class="image-grid"><view class="image-wrap" wx:for="{{form.images}}" wx:key="*this"><image src="{{item}}" mode="aspectFill" /><text wx:if="{{!submitting}}" data-index="{{index}}" bindtap="removeImage">×</text></view></view>
  </view>
  <view class="card">
    <view class="switch-row"><text>事项时间</text><switch color="#397BC5" checked="{{eventEnabled}}" bindchange="toggleEvent" disabled="{{submitting || initializing || initializationFailed}}" /></view>
    <view class="deadline-row" wx:if="{{eventEnabled}}"><picker mode="date" value="{{eventDate}}" bindchange="onEventDate" disabled="{{submitting || initializing || initializationFailed}}"><view class="picker">{{eventDate}}</view></picker><picker mode="time" value="{{eventClock}}" bindchange="onEventClock" disabled="{{submitting || initializing || initializationFailed}}"><view class="picker">{{eventClock}}</view></picker></view>
    <view class="switch-row"><text>截止时间</text><switch color="#397BC5" checked="{{deadlineEnabled}}" bindchange="toggleDeadline" disabled="{{submitting || initializing || initializationFailed}}" /></view>
    <view class="deadline-row" wx:if="{{deadlineEnabled}}"><picker mode="date" value="{{deadlineDate}}" bindchange="onDeadlineDate" disabled="{{submitting || initializing || initializationFailed}}"><view class="picker">{{deadlineDate}}</view></picker><picker mode="time" value="{{deadlineClock}}" bindchange="onDeadlineClock" disabled="{{submitting || initializing || initializationFailed}}"><view class="picker">{{deadlineClock}}</view></picker></view>
    <view class="muted">事项与截止时间用于展示安排，不会自动开启微信提醒。</view>
  </view>
  <view class="card">
    <view class="switch-row"><text>定时提醒</text><switch color="#4A90D9" checked="{{reminderEnabled}}" bindchange="toggleReminder" disabled="{{submitting || initializing || initializationFailed}}" /></view>
    <view wx:if="{{reminderEnabled}}">
      <view class="deadline-row"><picker mode="date" value="{{remindDate}}" bindchange="onRemindDate" disabled="{{submitting || initializing || initializationFailed}}"><view class="picker">{{remindDate}}</view></picker><picker mode="time" value="{{remindTime}}" bindchange="onRemindTime" disabled="{{submitting || initializing || initializationFailed}}"><view class="picker">{{remindTime}}</view></picker></view>
      <radio-group bindchange="onAdvanceChange"><label class="check"><radio value="1440" checked="{{form.remindAdvance[0] === 1440}}" disabled="{{submitting || initializing || initializationFailed}}" />提前1天</label><label class="check"><radio value="120" checked="{{form.remindAdvance[0] === 120}}" disabled="{{submitting || initializing || initializationFailed}}" />提前2小时</label></radio-group>
      <view class="target-label">提醒对象</view>
      <checkbox-group bindchange="onTargetsChange"><label class="check target-check" wx:for="{{reminderRelations}}" wx:key="value"><checkbox value="{{item.value}}" checked="{{item.checked}}" disabled="{{submitting || initializing || initializationFailed}}" />{{item.label}}</label></checkbox-group>
    </view>
  </view>
  <button class="primary-button save" loading="{{submitting}}" disabled="{{submitting || initializing || initializationFailed}}" bindtap="save">{{needsSubscription ? '保存并订阅提醒' : '保存通知'}}</button>
  <button wx:if="{{id && !submitting && !initializing && !initializationFailed}}" class="danger-button remove-button" bindtap="remove">删除通知</button>
</view>
