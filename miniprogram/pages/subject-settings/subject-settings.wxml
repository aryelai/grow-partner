<view class="page">
  <view class="card">
    <view class="section-title">当前科目</view>
    <view class="subject-list"><view class="subject {{item.isDefault ? 'default' : 'custom'}}" wx:for="{{subjectItems}}" wx:key="name"><text>{{item.name}}</text><text wx:if="{{!item.isDefault}}" class="remove" data-subject="{{item.name}}" bindtap="remove">×</text></view></view>
    <view class="muted tip">默认科目不能删除；自定义科目最多10个字。</view>
  </view>
  <view class="card add-row"><input class="input" maxlength="10" value="{{input}}" bindinput="onInput" bindconfirm="add" placeholder="添加自定义科目" /><button class="primary-button" size="mini" bindtap="add">添加</button></view>
</view>
