<view class="page">
  <view class="card">
    <view class="section-title">当前科目</view>
    <view class="subject-list">
      <view class="subject-item" wx:for="{{subjectItems}}" wx:key="name">
        <view class="subject-info">
          <text class="subject-name">{{item.name}}</text>
          <text class="subject-kind">{{item.isDefault ? '系统推荐' : '家庭自定义'}}</text>
        </view>
        <view class="subject-actions">
          <button class="ghost-button subject-action" disabled="{{renaming}}" data-subject="{{item.name}}" bindtap="beginRename">修改</button>
          <button wx:if="{{!item.isDefault}}" class="danger-button subject-action" disabled="{{renaming}}" data-subject="{{item.name}}" bindtap="remove">删除</button>
        </view>
      </view>
    </view>
    <view class="muted tip">所有科目都可修改名称；系统推荐科目不能直接删除。</view>
  </view>

  <view class="card edit-card" wx:if="{{editingSubject}}">
    <view class="section-title">修改科目</view>
    <view class="field">
      <text class="field-label">原名称</text>
      <view class="readonly-value">{{editingSubject}}</view>
    </view>
    <view class="field">
      <text class="field-label">新名称 *</text>
      <input class="input" maxlength="10" focus="{{true}}" disabled="{{renaming}}" value="{{editingInput}}" bindinput="onRenameInput" bindconfirm="rename" placeholder="请输入科目名称" />
    </view>
    <view class="edit-tip">修改只影响当前家庭后续选择和新建作业，不会批量改动历史作业。</view>
    <view class="edit-actions">
      <button class="ghost-button" disabled="{{renaming}}" bindtap="cancelRename">取消</button>
      <button class="primary-button" loading="{{renaming}}" disabled="{{renaming}}" bindtap="rename">保存修改</button>
    </view>
  </view>

  <view class="card add-card">
    <view class="section-title">添加自定义科目</view>
    <view class="add-row">
      <input class="input" maxlength="10" value="{{input}}" bindinput="onInput" bindconfirm="add" placeholder="最多 10 个字" />
      <button class="primary-button add-button" bindtap="add">添加</button>
    </view>
  </view>
</view>
