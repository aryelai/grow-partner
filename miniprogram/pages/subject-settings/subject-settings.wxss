.subject-list { display: flex; flex-wrap: wrap; gap: 14rpx; }.subject { display: flex; align-items: center; padding: 12rpx 20rpx; border-radius: 999rpx; background: #EEF1F5; }.subject.custom { color: var(--primary); background: var(--primary-light); }.remove { margin-left: 12rpx; color: var(--danger); font-size: 34rpx; }.tip { margin-top: 24rpx; font-size: 22rpx; }.add-row { display: flex; align-items: center; gap: 16rpx; }.add-row .input { flex: 1; }.add-row button { width: 130rpx; }
