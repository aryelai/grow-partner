.subject-list { display: flex; flex-wrap: wrap; gap: 14rpx; }.subject { display: flex; align-items: center; min-height: 72rpx; padding: 0 22rpx; border-radius: 999rpx; box-sizing: border-box; background: #EEF1F5; }.subject.custom { color: var(--primary); background: var(--primary-light); }.remove { display: flex; align-items: center; justify-content: center; width: 48rpx; height: 48rpx; margin-left: 8rpx; color: var(--danger); font-size: 34rpx; }.tip { margin-top: 24rpx; font-size: 22rpx; }.add-row { display: flex; align-items: center; gap: 16rpx; }.add-row .input { flex: 1; min-width: 0; }.add-row button { flex: 0 0 130rpx; width: 130rpx; min-height: 88rpx; padding: 0; }
