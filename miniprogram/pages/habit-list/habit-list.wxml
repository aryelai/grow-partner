<view class="page tab-page habit-page">
  <guest-banner wx:if="{{guestMode}}" />
  <view class="list-page-head"><view class="page-title">成长</view><view class="page-description">记录习惯，也把每天和每周的计划落到实处。</view></view>
  <view class="growth-switch">
    <button class="growth-switch-button {{view === 'habit' ? 'active' : ''}}" data-value="habit" bindtap="selectView" disabled="{{submitting}}" aria-label="习惯打卡，今日{{habitDone}}/{{habitTotal}}已完成"><view class="growth-switch-icon"><view class="ui-icon ui-icon-leaf"></view></view><view class="growth-switch-copy"><view class="growth-switch-title">习惯打卡</view><view class="growth-switch-meta">今日 {{habitDone}}/{{habitTotal}} 已完成</view></view></button>
    <button class="growth-switch-button {{view === 'plan' ? 'active' : ''}}" data-value="plan" bindtap="selectView" disabled="{{submitting}}"><view class="growth-switch-icon"><view class="ui-icon ui-icon-plan"></view></view><view class="growth-switch-copy"><view class="growth-switch-title">计划安排</view><view class="growth-switch-meta">{{planSummary}}</view></view></button>
  </view>
  <button class="review-entry {{view === 'review' ? 'active' : ''}}" data-value="review" bindtap="selectView" disabled="{{submitting}}"><view><view class="review-entry-title">本周复盘</view><view class="review-entry-note">只看完成进度、逾期和待关注事项</view></view><text class="chevron">›</text></button>
  <view wx:if="{{view === 'habit'}}">
    <view class="habit-toolbar"><text class="panel-title">今日习惯</text><button wx:if="{{canManage || guestMode}}" class="growth-add-button" bindtap="create" disabled="{{submitting}}">＋ 新增习惯</button></view>
    <view wx:if="{{creating}}" class="card habit-form">
      <view class="form-title">新增习惯</view>
      <view class="field"><text class="field-label">习惯名称 *</text><input class="input" value="{{habitForm.name}}" maxlength="40" data-field="name" bindinput="onHabitInput" disabled="{{submitting}}" placeholder="例如：每日阅读" /></view>
      <view class="field"><text class="field-label">分类</text><view class="tag-group"><text wx:for="{{habitCategories}}" wx:key="value" class="tag {{habitForm.category === item.value ? 'active' : ''}}" data-value="{{item.value}}" bindtap="selectHabitCategory">{{item.label}}</text></view></view>
      <view class="field"><text class="field-label">每日打卡目标 *</text><input class="input" value="{{habitForm.goal}}" maxlength="40" data-field="goal" bindinput="onHabitInput" disabled="{{submitting}}" placeholder="例如：阅读30分钟并记录收获" /></view>
      <view class="field"><text class="field-label">目标天数 *</text><input class="input" type="number" value="{{habitForm.targetDays}}" maxlength="3" data-field="targetDays" bindinput="onHabitInput" disabled="{{submitting}}" placeholder="1–365天" /></view>
      <view class="muted">每日目标会成为必选打卡项，可在习惯详情核对后打卡。</view>
      <view class="form-actions"><button class="ghost-button" bindtap="cancelCreate" disabled="{{submitting}}">取消</button><button class="primary-button" bindtap="saveHabit" disabled="{{submitting}}" loading="{{submitting}}">保存习惯</button></view>
    </view>
    <view class="growth-category-filters"><button wx:for="{{categories}}" wx:key="value" class="filter-chip {{selectedCategory === item.value ? 'active' : ''}}" data-value="{{item.value}}" bindtap="selectCategory">{{item.value === 'all' ? '全部' : item.value === 'behavior' ? '行为' : item.value === 'life' ? '生活' : '学习'}}</button></view>
    <view class="habit-hero" wx:if="{{!loading && !loadFailed}}"><view class="habit-hero-title">{{longestStreak ? '连续坚持 ' + longestStreak + ' 天' : '从今天开始坚持'}}</view><view class="habit-hero-note">{{habitProgressText}}</view><view class="habit-hero-caption" wx:if="{{longestStreak}}">以当前习惯最长连续打卡记录为准</view></view>
    <view class="habit-card" wx:for="{{items}}" wx:key="_id" data-id="{{item._id}}" bindtap="openDetail" hover-class="habit-card-pressed">
      <view class="habit-mark"><view class="ui-icon ui-icon-{{item.categoryIcon}}"></view></view>
      <view class="habit-copy"><view class="habit-name">{{item.name}}</view><view class="habit-meta">连续 {{item.streak}} 天 · 目标 {{item.completedDays}}/{{item.targetDays}} 天</view></view>
      <button class="checkin-button {{item.completedToday ? 'checked' : ''}}" data-id="{{item._id}}" catchtap="openDetail">{{item.completedToday ? '已打卡' : '去打卡'}}</button>
    </view>
    <view class="empty" wx:if="{{loadFailed}}">习惯加载失败<button class="ghost-button" bindtap="load">重新加载</button></view>
    <view class="empty" wx:if="{{!loading && !loadFailed && !items.length}}">当前分类还没有习惯</view>
    <view class="loading" wx:if="{{loading}}">加载中…</view>
  </view>
  <view hidden="{{view !== 'plan'}}"><plan-panel id="growth-plan" entry-date="{{planEntryDate}}" bindsummarychange="onPlanSummary"></plan-panel></view>
  <view wx:if="{{view === 'review'}}" class="weekly-review">
    <view wx:if="{{guestMode}}" class="empty">登录并加入家庭后，可查看真实的每周完成数据。<button class="ghost-button" bindtap="requestReviewAccess">去登录</button></view>
    <block wx:elif="{{weeklyReview}}">
      <view class="review-head"><view><view class="panel-title">本周客观记录</view><view class="review-range">{{weeklyReview.rangeLabel}}</view></view><view class="review-note">不排名，不做主观评价</view></view>
      <view class="review-warning" wx:if="{{weeklyReview.incomplete}}">本周记录较多，当前仅汇总前50条，请进入对应页面查看完整数据。</view>
      <button class="review-card" data-source="homework" bindtap="openReviewSource"><view class="review-card-main"><view class="review-card-title">作业</view><view class="review-card-value">{{weeklyReview.homework.done}} / {{weeklyReview.homework.total}}</view><view class="review-card-note">已完成 · {{weeklyReview.homework.percent}}%</view></view><view class="review-card-alerts"><text wx:if="{{weeklyReview.homework.overdue}}">逾期 {{weeklyReview.homework.overdue}}</text><text wx:if="{{weeklyReview.homework.needsAttention}}">待关注 {{weeklyReview.homework.needsAttention}}</text><text wx:if="{{!weeklyReview.homework.overdue && !weeklyReview.homework.needsAttention}}">暂无逾期或待关注</text></view></button>
      <button class="review-card" data-source="notice" bindtap="openReviewSource"><view class="review-card-main"><view class="review-card-title">通知要求</view><view class="review-card-value">{{weeklyReview.noticeRequirements.done}} / {{weeklyReview.noticeRequirements.total}}</view><view class="review-card-note">已落实 · {{weeklyReview.noticeRequirements.percent}}%</view></view><view class="review-card-alerts"><text>按通知内的要求清单统计</text></view></button>
      <button class="review-card" data-source="plan" bindtap="openReviewSource"><view class="review-card-main"><view class="review-card-title">计划任务</view><view class="review-card-value">{{weeklyReview.planTasks.done}} / {{weeklyReview.planTasks.total}}</view><view class="review-card-note">已完成 · {{weeklyReview.planTasks.percent}}%</view></view><view class="review-card-alerts"><text>查看本周计划</text></view></button>
      <button class="review-card" data-source="habit" bindtap="openReviewSource"><view class="review-card-main"><view class="review-card-title">今日习惯</view><view class="review-card-value">{{weeklyReview.habits.doneToday}} / {{weeklyReview.habits.total}}</view><view class="review-card-note">今日已打卡 · {{weeklyReview.habits.percent}}%</view></view><view class="review-card-alerts"><text>最长连续 {{weeklyReview.habits.longestStreak}} 天</text></view></button>
      <view class="review-caption">统计来自原始作业、通知要求、计划和习惯记录；修改原记录后刷新即可更新。</view>
    </block>
    <view class="empty" wx:if="{{reviewFailed}}">本周复盘加载失败<button class="ghost-button" bindtap="loadWeeklyReview">重新加载</button></view>
    <view class="loading" wx:if="{{reviewLoading}}">正在汇总本周记录…</view>
  </view>
</view>
