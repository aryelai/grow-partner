.card-heading { display: flex; align-items: center; justify-content: space-between; }.child-name { margin-bottom: 8rpx; font-size: 40rpx; font-weight: 700; }
.nickname { font-size: 26rpx; font-weight: 400; }.birthday { margin-top: 8rpx; font-size: 22rpx; }
.invite-row { display: flex; align-items: center; justify-content: space-between; margin-top: 24rpx; padding: 20rpx; border-radius: 14rpx; background: var(--primary-light); }
.invite-row .field-label { margin-bottom: 6rpx; }.invite-code { color: var(--primary); font-size: 32rpx; font-weight: 700; letter-spacing: 3rpx; }
.semester-row { display: flex; align-items: center; justify-content: space-between; margin-top: 28rpx; padding-top: 24rpx; border-top: 2rpx solid var(--border); text-align: center; }.semester-row button { width: 86rpx; color: var(--primary); background: transparent; font-size: 42rpx; }.semester { display: block; font-size: 32rpx; font-weight: 600; }
.menu-item { display: flex; justify-content: space-between; padding: 24rpx 0; border-bottom: 2rpx solid var(--border); }.menu-item:last-child { border-bottom: 0; }
.check { display: inline-flex; align-items: center; margin: 0 24rpx 18rpx 0; }.targets { margin-top: 14rpx; }
.subscription-card { display: flex; align-items: center; justify-content: space-between; gap: 20rpx; margin-bottom: 22rpx; padding: 20rpx; border-radius: 14rpx; background: var(--primary-light); }.subscription-title { margin-bottom: 8rpx; font-weight: 600; }.subscription-status { margin-bottom: 6rpx; color: var(--primary); font-size: 26rpx; }.subscription-count { margin-bottom: 6rpx; color: var(--primary); font-size: 26rpx; }.subscription-actions { display: flex; flex-direction: column; gap: 12rpx; }.subscription-button { flex: 0 0 auto; margin: 0; color: #FFFFFF; background: var(--primary); font-size: 24rpx; }.subscription-retry { flex: 0 0 auto; margin: 0; color: var(--primary); background: #FFFFFF; font-size: 22rpx; }
.switch-row { display: flex; align-items: center; justify-content: space-between; padding: 22rpx 0; border-top: 2rpx solid var(--border); }
.security-tip { padding: 18rpx; border-radius: 12rpx; color: var(--text-light); background: #F8F9FB; font-size: 22rpx; line-height: 1.6; }
.save { margin-top: 24rpx; }.about { padding: 40rpx; text-align: center; color: var(--text-light); font-size: 22rpx; }
