.subject-scroll { white-space: nowrap; }
.subject-row { display: inline-flex; }
.fixed { color: var(--text-light); background: #F8F9FB; }
.switch-row { display: flex; align-items: center; justify-content: space-between; padding: 22rpx 0; border-top: 2rpx solid var(--border); }
.deadline-row { display: flex; margin-top: 14rpx; }.deadline-row picker { flex: 1; }.deadline-row picker + picker { margin-left: 16rpx; }
.media-grid { display: flex; flex-wrap: wrap; gap: 14rpx; }
.media-item, .media-add { position: relative; width: 150rpx; height: 150rpx; padding: 0; border-radius: 12rpx; overflow: hidden; background: #EEF2F6; }
.media-item image { width: 100%; height: 100%; }
.media-item.video { color: var(--primary); text-align: center; line-height: 150rpx; }
.media-add { color: var(--text-light); font-size: 23rpx; line-height: 150rpx; }
.remove { position: absolute; top: 4rpx; right: 4rpx; width: 38rpx; height: 38rpx; border-radius: 50%; color: #fff; background: rgba(0, 0, 0, 0.58); text-align: center; line-height: 34rpx; }
.link-row { display: flex; align-items: center; gap: 12rpx; margin: 18rpx 0; }
.link-row .input { flex: 1; }
.list-item { display: flex; justify-content: space-between; padding: 12rpx 0; }
.link-text { max-width: 560rpx; overflow: hidden; color: var(--primary); text-overflow: ellipsis; white-space: nowrap; }
.remove-text { color: var(--danger); }
.removable { margin-bottom: 12rpx; }
.save-button { margin-bottom: 60rpx; }
