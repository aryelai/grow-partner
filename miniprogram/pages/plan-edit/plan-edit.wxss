.priority-picker { flex: 0 0 150rpx; width: 150rpx; }.delete { display: flex; align-items: center; justify-content: flex-end; flex: 0 0 76rpx; min-height: 88rpx; color: var(--danger); font-size: 23rpx; }
.save { margin-top: 24rpx; }.remove-button { margin-top: 18rpx; margin-bottom: 60rpx; }
