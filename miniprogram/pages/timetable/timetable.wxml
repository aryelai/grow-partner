<view class="page timetable-page {{canUseImport ? 'has-actions' : ''}}">
  <guest-banner wx:if="{{guestMode}}" />
  <view class="card timetable-heading">
    <view><view class="section-title compact-title">{{viewMode === 'date' ? '当天课程安排' : '本学期课程表'}}</view><view class="semester-label">{{semester}}</view></view>
    <view class="heading-tip">{{canManage ? (viewMode === 'date' ? '临时调整只影响所选日期' : '点击课程或空节次即可编辑') : '家庭共享，只读查看'}}</view>
  </view>

  <view class="timetable-mode"><button class="mode-button {{viewMode === 'week' ? 'active' : ''}}" data-value="week" bindtap="selectMode">每周课程</button><button class="mode-button {{viewMode === 'date' ? 'active' : ''}}" data-value="date" bindtap="selectMode">临时调课 / 停课</button></view>

  <scroll-view wx:if="{{viewMode === 'week'}}" class="day-scroll" scroll-x="{{true}}" enhanced="{{true}}" show-scrollbar="{{false}}">
    <view class="day-row"><view wx:for="{{days}}" wx:key="value" class="day-tab {{selectedDay === item.value ? 'active' : ''}}" data-value="{{item.value}}" bindtap="selectDay"><text class="day-short">{{item.shortLabel}}</text><text>{{item.label}}</text></view></view>
  </scroll-view>
  <view wx:else class="date-control"><button data-offset="-1" bindtap="changeDate" aria-label="前一天">‹</button><picker mode="date" value="{{selectedDate}}" bindchange="onDateChange"><view class="date-picker"><text>{{dateLabel}}</text><text class="date-picker-note">点击选择日期</text></view></picker><button data-offset="1" bindtap="changeDate" aria-label="后一天">›</button></view>

  <view class="slot-list" wx:if="{{!loading}}">
    <view class="slot-card {{item.hasEntry ? 'filled' : 'empty-slot'}} {{item.hasOverride ? 'temporary' : ''}} {{item.isCancelled ? 'cancelled' : ''}}" wx:for="{{slots}}" wx:key="period" data-period="{{item.period}}" bindtap="openSlot">
      <view class="period-badge"><text class="period-number">{{item.period}}</text><text>节</text></view>
      <view class="course-content" wx:if="{{item.isCancelled}}"><view class="course-name cancelled-name">{{item.baseEntry ? item.baseEntry.courseName : '停课'}}</view><view class="course-meta">当天停课 · 每周安排未修改</view></view>
      <view class="course-content" wx:elif="{{item.hasEntry}}">
        <view class="course-name">{{item.entry.courseName}}</view>
        <view class="temporary-label" wx:if="{{item.hasOverride}}">临时调整</view>
        <view class="course-meta" wx:if="{{item.entry.teacher || item.entry.location}}">{{item.entry.teacher || '未填教师'}}<text wx:if="{{item.entry.location}}"> · {{item.entry.location}}</text></view>
        <view class="course-time" wx:if="{{item.entry.startTime}}">{{item.entry.startTime}}–{{item.entry.endTime}}</view>
      </view>
      <view class="empty-course" wx:else>{{canManage ? (viewMode === 'date' ? '＋ 添加当天临时课程' : '＋ 添加课程') : '暂无课程'}}</view>
      <text class="slot-action" wx:if="{{canManage}}">›</text>
    </view>
  </view>
  <view class="load-more" wx:if="{{loading}}">课程表加载中…</view>

  <view class="timetable-actions" wx:if="{{canUseImport}}"><button class="ghost-button ai-import-button {{canImport ? '' : 'unavailable'}}" bindtap="importTimetable">智能识别课程表截图</button></view>
</view>
