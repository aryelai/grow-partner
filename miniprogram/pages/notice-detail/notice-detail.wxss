.detail-title { font-size: 40rpx; font-weight: 700; line-height: 1.55; }
.remind-icon { margin-right: 8rpx; color: var(--danger); }
.meta-grid { display: flex; flex-wrap: wrap; margin-top: 26rpx; color: var(--text-light); font-size: 24rpx; }
.meta-grid text { width: 50%; margin-bottom: 14rpx; }
.content { margin-top: 32rpx; padding-top: 26rpx; border-top: 2rpx solid var(--border); white-space: pre-wrap; line-height: 1.8; }
.requirements-panel { margin-top: 28rpx; padding-top: 24rpx; border-top: 2rpx solid var(--border); }
.requirements-heading { display: flex; align-items: center; justify-content: space-between; margin-bottom: 14rpx; color: var(--text); font-size: 28rpx; font-weight: 700; }
.requirements-heading text:last-child { color: var(--primary); font-size: 24rpx; font-weight: 600; }
.requirement-item { display: flex; width: 100%; min-height: var(--touch-size); align-items: center; gap: 16rpx; margin: 10rpx 0 0; padding: 14rpx 16rpx; border: 0; border-radius: 12rpx; box-sizing: border-box; color: var(--text); background: #F5F8FB; font-size: 27rpx; line-height: 1.5; text-align: left; }
.requirement-item.done { color: #66757F; background: #F4FAF7; }
.requirement-check { display: flex; width: 42rpx; height: 42rpx; flex: 0 0 42rpx; align-items: center; justify-content: center; border: 2rpx solid #B8C6D1; border-radius: 50%; box-sizing: border-box; color: #fff; background: #fff; font-size: 25rpx; }
.requirement-item.done .requirement-check { border-color: var(--success); background: var(--success); }
.requirement-text { min-width: 0; flex: 1; white-space: normal; word-break: break-all; }
.requirement-item.done .requirement-text { text-decoration: line-through; }
.image-grid { display: flex; flex-wrap: wrap; margin-top: 24rpx; }
.image-grid image { width: calc((100% - 24rpx) / 3); height: 200rpx; margin: 0 12rpx 12rpx 0; border-radius: 12rpx; }
.image-grid image:nth-child(3n) { margin-right: 0; }
.action { margin-top: 24rpx; }
.key-time { margin-top: 20rpx; padding: 16rpx 20rpx; border-radius: 12rpx; color: #8A5A1C; background: #FFF5E7; font-size: 30rpx; font-weight: 600; }
.notice-state { margin-top: 16rpx; color: var(--text-light); }
.meta-grid text { box-sizing: border-box; padding-right: 12rpx; line-height: 1.6; word-break: break-all; }
@media (max-width: 360px) { .meta-grid text { width: 100%; } }
