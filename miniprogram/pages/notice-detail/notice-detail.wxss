.detail-title { font-size: 40rpx; font-weight: 700; line-height: 1.55; }
.remind-icon { margin-right: 8rpx; color: var(--danger); }
.meta-grid { display: flex; flex-wrap: wrap; margin-top: 26rpx; color: var(--text-light); font-size: 24rpx; }
.meta-grid text { width: 50%; margin-bottom: 14rpx; }
.content { margin-top: 32rpx; padding-top: 26rpx; border-top: 2rpx solid var(--border); white-space: pre-wrap; line-height: 1.8; }
.image-grid { display: flex; flex-wrap: wrap; margin-top: 24rpx; }
.image-grid image { width: calc((100% - 24rpx) / 3); height: 200rpx; margin: 0 12rpx 12rpx 0; border-radius: 12rpx; }
.image-grid image:nth-child(3n) { margin-right: 0; }
.action { margin-top: 24rpx; }
.key-time { margin-top: 20rpx; padding: 16rpx 20rpx; border-radius: 12rpx; color: #8A5A1C; background: #FFF5E7; font-size: 30rpx; font-weight: 600; }
.notice-state { margin-top: 16rpx; color: var(--text-light); }
.meta-grid text { box-sizing: border-box; padding-right: 12rpx; line-height: 1.6; word-break: break-all; }
@media (max-width: 360px) { .meta-grid text { width: 100%; } }
