<view class="page tab-page homework-page {{undoId ? 'has-feedback' : ''}}">
  <guest-banner wx:if="{{guestMode}}" />
  <view class="list-toolbar"><text class="list-toolbar-title">作业</text><view class="list-toolbar-actions"><button wx:if="{{canUseImport || guestMode}}" class="toolbar-button {{canImport || guestMode ? '' : 'unavailable'}}" bindtap="importHomework">智能导入</button><button wx:if="{{canManage || guestMode}}" class="toolbar-button primary" bindtap="createHomework">＋ 新增</button><button class="toolbar-button more" bindtap="showMore" aria-label="更多作业操作"><view class="more-dots"><view class="more-dot" /><view class="more-dot" /><view class="more-dot" /></view></button></view></view>
  <view class="filter-panel">
    <view class="scope-row">
      <view class="scope-item {{scope === 'date' ? 'active' : ''}}" data-value="date" bindtap="selectScope">指定日期</view>
      <view class="scope-item {{scope === 'pending' ? 'active' : ''}}" data-value="pending" bindtap="selectScope">全部待办</view>
    </view>
    <view class="date-switcher" wx:if="{{scope === 'date'}}">
      <button class="date-arrow" data-offset="-1" bindtap="changeDate" aria-label="查看前一天作业">‹</button>
      <button class="date-picker" bindtap="openCalendar" aria-label="选择作业日期">
        <view class="date-current">
          <text class="date-value">{{selectedDateText}}</text>
          <text class="date-hint">点击选择日期</text>
        </view>
      </button>
      <button class="date-arrow" data-offset="1" bindtap="changeDate" aria-label="查看后一天作业">›</button>
    </view>
    <view class="filter-label">按科目筛选</view>
    <scroll-view class="subject-scroll" scroll-x="{{true}}" enhanced="{{true}}" show-scrollbar="{{false}}">
      <view class="subject-row">
        <view wx:for="{{subjects}}" wx:key="*this" class="tag {{selectedSubject === item ? 'active' : ''}}" data-value="{{item}}" bindtap="selectSubject">{{item}}</view>
      </view>
    </scroll-view>
    <view class="status-row" wx:if="{{scope === 'date'}}">
      <view wx:for="{{statuses}}" wx:key="value" class="status-item {{status === item.value ? 'active' : ''}}" data-value="{{item.value}}" bindtap="selectStatus">{{item.label}}</view>
    </view>
    <view class="search-box">⌕<input class="search-input" placeholder="搜索作业主题" value="{{keyword}}" bindinput="onSearchInput" /></view>
  </view>

  <view class="homework-list">
    <view class="card homework-card {{homework.isCompleted ? 'completed' : ''}}" wx:for="{{items}}" wx:for-item="homework" wx:key="_id" data-id="{{homework._id}}" bindtap="openDetail">
      <view class="homework-labels">
        <view class="homework-subject-label"><text class="homework-label-value">{{homework.subject}}</text></view>
        <view class="homework-date-label {{homework.homeworkDateMissing ? 'missing' : ''}}"><text class="homework-label-value">{{homework.homeworkDateText}}</text></view>
      </view>
      <view class="title-row">
        <text wx:if="{{homework.isImportant}}" class="important">★</text>
        <text wx:if="{{homework.hasDeadline}}" class="deadline-icon">◷</text>
        <text class="homework-title">{{homework.title}}</text>
        <text wx:if="{{homework.extraRequirement}}" class="extra">（{{homework.extraRequirement}}）</text>
      </view>
      <view class="requirements"><text class="requirements-label">详细要求：</text>{{homework.content || '无'}}</view>
      <view wx:if="{{homework.hasDeadline}}" class="deadline-meta {{homework.isOverdue ? 'overdue' : ''}}">截止：{{homework.deadlineText}}</view>
      <view class="meta">录入：{{homework.createdByName}}</view>
      <view class="tags" wx:if="{{homework.extraTags.length}}"><text class="small-tag" wx:for="{{homework.extraTags}}" wx:for-item="tagItem" wx:key="*this">{{tagItem}}</text></view>
      <view class="learning-state-row">
        <text class="learning-state {{homework.learningState || 'empty'}}">{{homework.learningState ? homework.learningStateText : '未标记学习状态'}}</text>
        <button class="learning-state-button" disabled="{{learningStateBusy || loading}}" data-id="{{homework._id}}" catchtap="changeLearningState">{{homework.learningState ? '修改状态' : '标记状态'}}</button>
      </view>
      <view class="media-row" wx:if="{{homework.images.length || homework.videos.length || homework.links.length}}">
        <image class="thumb" wx:for="{{homework.images}}" wx:for-item="imageUrl" wx:key="*this" src="{{imageUrl}}" mode="aspectFill" data-url="{{imageUrl}}" data-urls="{{homework.images}}" catchtap="previewImage" />
        <text class="media-badge" wx:if="{{homework.videos.length}}">视频 1</text>
        <text class="media-badge" wx:if="{{homework.links.length}}">链接 {{homework.links.length}}</text>
      </view>
      <view class="card-footer">
        <text class="state {{homework.isCompleted ? 'done' : ''}}">{{homework.isCompleted ? '✓ 已完成' : '● 未完成'}}</text>
        <button class="completion-button" disabled="{{completionBusy || loading}}" data-id="{{homework._id}}" catchtap="toggleCompleted">{{homework.isCompleted ? '撤销完成' : '标为完成'}}</button>
      </view>
    </view>
    <view class="empty" wx:if="{{loadFailed}}">作业加载失败<button class="ghost-button" bindtap="retryLoad">重新加载</button></view>
    <view class="empty" wx:if="{{!loading && !loadFailed && !items.length}}">{{scope === 'pending' ? '暂无未完成作业' : selectedDateText + '暂无符合条件的作业'}}</view>
    <view class="load-more" wx:if="{{loading}}">加载中…</view>
    <view class="load-more" wx:if="{{!loading && items.length && !hasMore}}">已加载全部</view>
  </view>
  <view class="completion-feedback" wx:if="{{undoId}}"><text class="completion-feedback-text">{{completionText}}</text><button bindtap="undoCompleted" disabled="{{completionBusy || loading}}">撤销</button><button bindtap="dismissCompletion">关闭</button></view>
  <date-calendar visible="{{calendarVisible}}" value="{{selectedDate}}" bindchange="onDateChange" bindclose="closeCalendar" />
</view>
