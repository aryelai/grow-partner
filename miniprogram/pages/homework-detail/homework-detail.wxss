.detail-title { font-size: 36rpx; font-weight: 700; line-height: 1.65; white-space: pre-wrap; word-break: break-all; }
.important { margin-right: 8rpx; color: #F4B400; }
.deadline-icon, .extra, .overdue { color: var(--danger); }
.meta-grid { margin-top: 26rpx; color: #66757F; font-size: 24rpx; }.meta-grid text { display: block; margin-bottom: 12rpx; word-break: break-all; }
.content { margin-top: 32rpx; padding-top: 26rpx; border-top: 2rpx solid var(--border); white-space: pre-wrap; line-height: 1.8; }
.content .section-title { margin-top: 0; font-size: 28rpx; }
.no-requirements { color: #66757F; }
.learning-state-panel { display: flex; align-items: center; justify-content: space-between; gap: 24rpx; margin-top: 24rpx; padding: 20rpx 22rpx; border-radius: 16rpx; background: #F5F8FB; }
.learning-state-title { margin: 0 0 6rpx; color: #66757F; font-size: 23rpx; }
.learning-state-value { color: #9A6500; font-size: 28rpx; font-weight: 700; }
.learning-state-value.empty { color: #66757F; font-weight: 400; }
.learning-state-button { min-width: 176rpx; min-height: var(--touch-size); flex: 0 0 auto; margin: 0; padding: 0 22rpx; border: 2rpx solid #B8D8CA; border-radius: 12rpx; box-sizing: border-box; color: #18794E; background: #EEF8F3; font-size: 26rpx; }
.image-grid { display: flex; flex-wrap: wrap; margin-top: 24rpx; }
.image-grid image { width: calc((100% - 24rpx) / 3); height: 200rpx; margin: 0 12rpx 12rpx 0; border-radius: 12rpx; }.image-grid image:nth-child(3n) { margin-right: 0; }
.video { width: 100%; margin-top: 24rpx; }
.link { margin-top: 18rpx; color: var(--primary); overflow-wrap: anywhere; }
.tags { margin-top: 24rpx; }
.action { margin-top: 24rpx; }
.action-row { display: flex; margin-top: 20rpx; }.action-row button { flex: 1; }.action-row button + button { margin-left: 20rpx; }
