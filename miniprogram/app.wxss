@import "./styles/ui-icons.wxss";

page {
  --primary: #397BC5;
  --primary-light: #EAF3FC;
  --danger: #E74C3C;
  --warning: #F39C12;
  --success: #27AE60;
  --gray: #95A5A6;
  --border: #E4EAF0;
  --bg: #F4F7FA;
  --card-bg: #FFFFFF;
  --text: #21313D;
  --text-light: #627481;
  --touch-size: 44px;
  --page-gutter: 32rpx;
  --radius-card: 24rpx;
  min-height: 100%;
  background: var(--bg);
  color: var(--text);
  font-size: 28rpx;
  line-height: 1.5;
}

button { margin: 0; }
button::after { border: 0; }
.page { padding: 24rpx 24rpx calc(40rpx + env(safe-area-inset-bottom)); box-sizing: border-box; }
.card { margin-bottom: 24rpx; padding: 30rpx; border: 2rpx solid rgba(44, 62, 80, 0.04); border-radius: 20rpx; background: var(--card-bg); box-shadow: 0 6rpx 24rpx rgba(44, 62, 80, 0.06); }
.section-title { margin: 8rpx 0 22rpx; font-size: 32rpx; font-weight: 600; line-height: 1.4; }
.field { margin-bottom: 30rpx; }
.field:last-child { margin-bottom: 0; }
.field-label { display: block; margin-bottom: 12rpx; color: #66757F; font-size: 25rpx; font-weight: 500; line-height: 1.4; }
.input, .textarea, .picker {
  width: 100%;
  box-sizing: border-box;
  border: 2rpx solid #DCE2E8;
  border-radius: 14rpx;
  background: #FFFFFF;
  color: var(--text);
  font-size: 28rpx;
}
.input {
  height: 88rpx;
  min-height: 88rpx;
  padding: 0 24rpx;
  line-height: 88rpx;
}
.picker {
  display: flex;
  align-items: center;
  min-height: 88rpx;
  padding: 0 24rpx;
  line-height: 1.4;
}
.textarea {
  min-height: 220rpx;
  padding: 20rpx 24rpx;
  line-height: 1.65;
}
.input:focus, .textarea:focus, .picker:active { border-color: var(--primary); box-shadow: 0 0 0 6rpx rgba(74, 144, 217, 0.10); }
.input[disabled], .textarea[disabled] { background: #F6F8FA; color: var(--text-light); }
.primary-button, .danger-button, .ghost-button {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 88rpx;
  padding: 0 28rpx;
  border-radius: 16rpx;
  box-sizing: border-box;
  font-size: 28rpx;
  font-weight: 600;
  line-height: 1.3;
}
.primary-button { color: #fff; background: var(--primary); box-shadow: 0 8rpx 20rpx rgba(74, 144, 217, 0.20); }
.danger-button { color: var(--danger); background: #FFF2F0; }
.ghost-button { color: var(--primary); background: var(--primary-light); }
.primary-button[disabled], .danger-button[disabled], .ghost-button[disabled] { box-shadow: none; opacity: 0.55; }
.row { display: flex; align-items: center; }
.between { justify-content: space-between; }
.muted { color: var(--text-light); }
.empty { padding: 100rpx 24rpx; text-align: center; color: var(--text-light); }
.tag-group { display: flex; flex-wrap: wrap; gap: 14rpx; }
.tag { display: inline-flex; align-items: center; justify-content: center; min-height: 88rpx; margin-right: 12rpx; padding: 0 24rpx; border-radius: 999rpx; box-sizing: border-box; background: #EEF1F5; color: var(--text-light); line-height: 1.3; white-space: nowrap; }
.tag-group .tag { margin-right: 0; }
.tag.active { color: #fff; background: var(--primary); }
.fab { position: fixed; right: 36rpx; bottom: calc(150rpx + env(safe-area-inset-bottom)); z-index: 8; width: 96rpx; height: 96rpx; padding: 0; border-radius: 50%; color: #fff; background: var(--primary); font-size: 52rpx; line-height: 92rpx; box-shadow: 0 10rpx 30rpx rgba(74, 144, 217, 0.35); }

.homework-labels { display: flex; flex-wrap: wrap; align-items: center; gap: 12rpx; margin-bottom: 20rpx; }
.homework-subject-label, .homework-date-label { display: inline-block; max-width: 100%; padding: 10rpx 18rpx; border-radius: 12rpx; box-sizing: border-box; font-size: 26rpx; font-weight: 600; line-height: 1.5; word-break: break-all; }
.homework-subject-label { color: #2F6EAD; background: var(--primary-light); }
.homework-date-label { color: #43545F; background: #F0F3F6; }
.homework-date-label.missing { color: #8A5A00; background: #FFF4DF; }
.homework-theme-input { min-height: 220rpx; }
.homework-date-picker { justify-content: space-between; gap: 12rpx; background: var(--primary-light); border-color: #B9D5F0; font-weight: 600; }
.homework-date-picker .picker-action { flex-shrink: 0; color: #2F6EAD; font-size: 24rpx; }
.homework-field-help { margin-top: 10rpx; color: #66757F; font-size: 24rpx; line-height: 1.6; }

.list-toolbar { position: sticky; top: 0; z-index: 12; display: flex; align-items: center; justify-content: space-between; gap: 16rpx; margin: 0 -24rpx 24rpx; padding: 16rpx 24rpx; border-bottom: 1px solid var(--border); background: var(--bg); }
.list-toolbar-title { min-width: 0; font-size: 36rpx; font-weight: 700; }
.list-toolbar-actions { display: flex; flex-shrink: 0; align-items: center; gap: 12rpx; }
.toolbar-button { display: flex; align-items: center; justify-content: center; min-width: var(--touch-size); min-height: var(--touch-size); padding: 0 20rpx; border-radius: 16rpx; color: #245F9F; background: var(--primary-light); font-size: 26rpx; font-weight: 600; line-height: 1.3; }
.toolbar-button.primary { color: #fff; background: var(--primary); }
.toolbar-button.more { padding: 0; background: #E9EEF3; }
.more-dots { display: flex; align-items: center; justify-content: center; gap: 4px; }
.more-dot { width: 4px; height: 4px; border-radius: 50%; background: #245F9F; }
.toolbar-button.unavailable { color: var(--text-light); background: #E9EEF3; }
.toolbar-button:active, .completion-button:active { opacity: .75; }
.completion-button { display: flex; align-items: center; justify-content: center; gap: 10rpx; min-height: var(--touch-size); min-width: 176rpx; padding: 0 20rpx; border: 1px solid #B7DFCA; border-radius: 16rpx; box-sizing: border-box; color: #20764E; background: #E8F6EF; font-size: 26rpx; font-weight: 600; line-height: 1.3; }
.completion-button[disabled] { opacity: .6; }
.completion-feedback { position: fixed; right: 24rpx; bottom: calc(24rpx + env(safe-area-inset-bottom)); left: 24rpx; z-index: 15; display: flex; align-items: center; justify-content: space-between; gap: 16rpx; padding: 14rpx 20rpx; border: 1px solid #D8E5F0; border-radius: 20rpx; background: #fff; box-shadow: 0 8rpx 32rpx rgba(33,49,61,.15); }
.completion-feedback-text { flex: 1; min-width: 0; font-size: 26rpx; }
.completion-feedback button { flex-shrink: 0; min-height: var(--touch-size); padding: 0 20rpx; color: #245F9F; background: var(--primary-light); border-radius: 12rpx; font-size: 26rpx; }
.page.tab-page { padding-bottom: calc(96px + env(safe-area-inset-bottom)); }
.tab-page .completion-feedback { bottom: calc(76px + env(safe-area-inset-bottom)); }
