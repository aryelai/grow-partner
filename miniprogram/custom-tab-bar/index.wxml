<view class="main-tab-bar">
  <button class="main-tab {{selected === index ? 'active' : ''}}" wx:for="{{tabs}}" wx:key="pagePath" data-index="{{index}}" bindtap="switchTab" disabled="{{switching}}" aria-label="{{item.text}}" aria-role="button">
    <image class="main-tab-icon" src="/{{selected === index ? item.selectedIconPath : item.iconPath}}" mode="aspectFit" />
    <text class="main-tab-label">{{item.text}}</text>
  </button>
</view>
