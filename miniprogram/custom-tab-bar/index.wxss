.main-tab-bar { position: fixed; right: 0; bottom: 0; left: 0; z-index: 30; display: flex; align-items: stretch; padding: 2px 8px 0; padding-bottom: constant(safe-area-inset-bottom); padding-bottom: env(safe-area-inset-bottom); border-top: 1px solid #E4EAF0; background: #fff; }
.main-tab { display: flex; flex: 1; flex-direction: column; align-items: center; justify-content: center; gap: 2px; min-width: 0; height: 62px; margin: 0; padding: 2px 0 6px; box-sizing: border-box; color: #627481; background: transparent; line-height: 18px; border-radius: 0; }
.main-tab::after { border: 0; }
.main-tab.active { color: #397BC5; font-weight: 600; }
.main-tab:active { background: #F1F6FB; }
.main-tab-icon { width: 36px; height: 36px; }
.main-tab-label { font-size: 14px; line-height: 18px; }
